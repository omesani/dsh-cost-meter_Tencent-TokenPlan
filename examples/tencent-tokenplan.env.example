# 腾讯云 Token Plan 个人版 —— dsh-cost-meter 原生额度查询
#
# 用法：
#   cp examples/tencent-tokenplan.env.example ~/.dsh/tencent-tokenplan.env
#   chmod 600 ~/.dsh/tencent-tokenplan.env
#   然后把下面两行改成真实值（本文件被复制后才会包含密钥，不要提交真实值）
#
# 必须是【云 API 密钥】（SecretId 以 AKID 开头），在
#   https://console.cloud.tencent.com/capi
# 获取；不是 Token Plan 的 sk-tp- 推理 API Key。
#
# 权限：主账号，或已授予 TokenHub 管控面读取权限的 CAM 子账号。

TENCENTCLOUD_SECRET_ID=***
TENCENTCLOUD_SECRET_KEY=***

# —— 可选 ——
# 不是通用 Standard（1980 积分）时改这里：
#   Lite 780 / Standard 1980 / Pro 5980 / Max 11980
#   Hy 系列：560 / 1560 / 4760 / 9360
# TENCENT_TOKENPLAN_MONTHLY_CREDITS=1980
#
# 响应结构与预期不同时，指定 credit 字段的点分路径：
# TENCENT_TOKENPLAN_CREDIT_PATH=Response.credit
#
# Hy 系列套餐：
# TENCENT_TOKENPLAN_PRODUCT_TYPE=personal-hunyuan
#
# 企业版接口（需要 TeamId，见 docs 132270）：
# TENCENT_TOKENPLAN_ACTION=DescribeTokenPlan
# TENCENT_TOKENPLAN_TEAM_ID=***
#
# 请求地域，默认 ap-guangzhou：
# TENCENTCLOUD_REGION=ap-guangzhou
